# NexusOps Environment Configuration
NEXUSOPS_HOST=0.0.0.0
NEXUSOPS_PORT=8000
NEXUSOPS_DEBUG=true
NEXUSOPS_ENV=development

# Security & API Keys
# Role mapping: token -> role (admin, operator, readonly)
NEXUSOPS_ADMIN_API_KEY=nexus-admin-secret-key-12345
NEXUSOPS_OPERATOR_API_KEY=nexus-operator-secret-key-67890
NEXUSOPS_READONLY_API_KEY=nexus-readonly-secret-key-abcde

# Human-in-the-Loop approval timeout (seconds)
NEXUSOPS_APPROVAL_TIMEOUT_SECONDS=300

# Upstream MCP Servers for Orchestration (comma-separated URLs, optional)
NEXUSOPS_UPSTREAM_MCP_SERVERS=
